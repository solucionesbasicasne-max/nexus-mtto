{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "wo_number": {
      "type": "string",
      "description": "N\u00famero de OT (OT-0001)"
    },
    "mp_id": {
      "type": "string",
      "description": "ID del MP relacionado"
    },
    "plan_id": {
      "type": "string",
      "description": "ID del plan"
    },
    "wo_type": {
      "type": "string",
      "enum": [
        "Preventiva",
        "Correctiva",
        "Predictiva",
        "Mejora"
      ],
      "default": "Correctiva"
    },
    "description": {
      "type": "string"
    },
    "request_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha inicio programada"
    },
    "scheduled_end_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha fin programada"
    },
    "actual_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "actual_end_date": {
      "type": "string",
      "format": "date-time"
    },
    "location_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "assigned_employee_id": {
      "type": "string",
      "description": "ID del empleado t\u00e9cnico asignado"
    },
    "status": {
      "type": "string",
      "enum": [
        "Generada",
        "Planificada",
        "Aprobada",
        "Programada",
        "En proceso",
        "Completa",
        "Revisi\u00f3n",
        "Cerrada",
        "Pendiente",
        "En Proceso",
        "Completada",
        "Cancelada"
      ],
      "default": "Generada"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Cr\u00edtica",
        "Alta",
        "Media",
        "Baja"
      ],
      "default": "Media"
    },
    "responsible_technician": {
      "type": "string"
    },
    "team_technicians": {
      "type": "string"
    },
    "estimated_duration_hours": {
      "type": "number"
    },
    "actual_duration_hours": {
      "type": "number",
      "description": "Duraci\u00f3n real calculada"
    },
    "equipment_shutdown_hours": {
      "type": "number",
      "default": 0,
      "description": "Horas de paro del equipo durante la actividad"
    },
    "total_cost": {
      "type": "number",
      "default": 0
    },
    "observations": {
      "type": "string"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technician_signature": {
      "type": "string"
    },
    "supervisor_signature": {
      "type": "string"
    },
    "client_signature": {
      "type": "string"
    },
    "timer_start": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "wo_type",
    "description"
  ]
}